nbins: 15
minimum: 7
alpha: 1.19951
fixed: 30
bbins: 8
minentries: 5
# Truth bins must have >= this many unweighted matched MC fills into the kept
# reco bins. Tuned so kept truth bins (92) <= kept reco bins (95): with more
# truth than reco bins the unfolding is under-determined and the Bayes prior
# never decouples (non-converging prior sensitivity). Drops only corner bins
# carrying ~1e-5 of the truth weight.
minentries_link: 100

primer: 0

truth_leading_goal: 13.99
truth_subleading_goal: 0

reco_leading_bin_buffer: 3
reco_subleading_bin_buffer: 1

measure_leading_bin_buffer: 4
measure_subleading_bin_buffer: 2

dphi_top: 7
dphi_bottom: 8

measure_bins: 3;
pt1_0: 20
pt1_1: 30
pt1_2: 40
pt1_3: 60

pt2_0: 9
pt2_1: 20
pt2_2: 25
pt2_3: 30

low_trigger: 16
first_xj: 0.2

#systematics

JER: 0.0
# Total Au+Au JES uncertainty = finalized p+p in-situ gamma+jet JES (2.6%,
# PPG-08 final) (+) 3.0% quark/gluon quenched-response term (Au+Au IAN
# Sec. 4.1) in quadrature: sqrt(0.026^2 + 0.030^2) = 0.0397.
# The Aug 5 JSTG slides quoted 2.6% (p+p component only); dropping the 3%
# term needs explicit sign-off - to do so set this back to 0.026.
JES: 0.0397
NJET: 0
VTX: 0
PRIOR: 0
FLOW: 1